# Copia este archivo como .env y completa los valores.
# El archivo .env NO se sube al repositorio.
# Sugerencia para generar contraseñas y tokens: openssl rand -hex 16

# PostgreSQL + pgvector (usuario: chatbot)
PG_PASSWORD=

# Réplica de MariaDB
REPLICA_ROOT_PASSWORD=
# Usuario de solo lectura chatbot_ro
REPLICA_RO_PASSWORD=

# Token del endpoint POST /api/ingesta (encabezado X-Admin-Token)
CHATBOT_ADMIN_TOKEN=

# Máximo de preguntas por IP en un minuto (frontend)
CHAT_LIMITE_POR_MINUTO=10
